{
  "name": "hihyou",
  "description": "批評 — an alternative GitHub code review experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "check": "node utils/pr-location.check.ts && node utils/seen-hunks.check.ts && node utils/file-tree.check.ts && node utils/prose-diff.check.ts && node utils/ast-service.check.ts",
    "postinstall": "wxt prepare && node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@shikijs/langs": "^4.3.1",
    "@shikijs/themes": "^4.3.1",
    "@webext-core/messaging": "^3.0.2",
    "diff": "^9.0.0",
    "marked": "^18.0.6",
    "shiki": "^4.3.1",
    "shiki-magic-move": "^1.4.0",
    "solid-js": "^1.9.11",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
