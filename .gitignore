node_modules/
dist/
*.tsbuildinfo
coverage/
.claude/
# No trailing slash: scripts/worktree-setup.js makes these symlinks, which a directory-only pattern misses.
research/parser-bench/inputs
packages/syntechs/corpus
# A grammar package tracks only its manifest and patch; its postinstall assembles the rest, from .cache/.
packages/syntechs/grammars/*/*
!packages/syntechs/grammars/*/package.json
!packages/syntechs/grammars/*/grammar.patch
packages/syntechs/grammars/.cache/
# Language bundles are derived from the grammar packages; `pnpm install` regenerates them.
packages/syntechs/src/grammars/*/bundle.js
packages/syntechs/src/grammars/*/fmt.gen.ts
packages/syntechs/src/grammars/*/highlight.gen.ts
# VitePress's cache; its build output lands in docs/.vitepress/dist, which dist/ above covers.
packages/website/docs/.vitepress/cache/
# The VS Code builds @vscode/test-electron and @vscode/test-web download to run the extension's integration tests.
packages/vscode/.vscode-test/
packages/vscode/.vscode-test-web/
