+// Past one piece of a raw value: a string, a `/* */` comment, or a character, counting open brackets in `depth`.
+// Whether the piece is more than whitespace.
+static bool advance_piece(TSLexer *lexer, int *depth) {
+    int32_t c = lexer->lookahead;
+    advance(lexer);
+    if (c == '"' || c == '\'') {
+        while (!lexer->eof(lexer) && lexer->lookahead != c && lexer->lookahead != '\n') {
+            if (lexer->lookahead == '\\') {
+                advance(lexer);
+            }
+            advance(lexer);
+        }
+        if (lexer->lookahead == c) {
+            advance(lexer);
+        }
+    } else if (c == '/' && lexer->lookahead == '*') {
+        advance(lexer);
+        while (!lexer->eof(lexer)) {
+            if (lexer->lookahead != '*') {
+                advance(lexer);
+                continue;
