+            advance(lexer);
+            if (lexer->lookahead == '/') {
+                advance(lexer);
+                break;
+            }
+        }
+    } else if (c == '{' || c == '(' || c == '[') {
+        (*depth)++;
+    } else if (c == '}' || c == ')' || c == ']') {
+        (*depth)--;
+    }
