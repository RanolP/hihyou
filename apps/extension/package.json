{
  "name": "@hihyou/extension",
  "description": "批評 — an alternative GitHub code review experience",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/ascii-escape.mjs",
    "build:firefox": "wxt build -b firefox && node scripts/ascii-escape.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare && node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@hihyou/diff-engine": "workspace:*",
    "@hihyou/github": "workspace:*",
    "@pierre/trees": "1.0.0-beta.5",
    "@typescript/vfs": "^1.6.4",
    "@webext-core/messaging": "^3.0.2",
    "marked": "^18.0.6",
    "shiki-magic-move": "^1.4.0",
    "solid-js": "^1.9.11",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@vscode/tree-sitter-wasm": "^0.3.1",
    "@wxt-dev/module-solid": "^1.1.4",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  }
}
