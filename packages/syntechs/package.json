{
  "name": "syntechs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "@hihyou/source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./compiler": {
      "@hihyou/source": "./src/compiler/index.ts",
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./diff": {
      "@hihyou/source": "./src/diff/index.ts",
      "types": "./dist/diff/index.d.ts",
      "default": "./dist/diff/index.js"
    },
    "./fmt": {
      "@hihyou/source": "./src/fmt/index.ts",
      "types": "./dist/fmt/index.d.ts",
      "default": "./dist/fmt/index.js"
    },
    "./highlight": {
      "@hihyou/source": "./src/highlight/index.ts",
      "types": "./dist/highlight/index.d.ts",
      "default": "./dist/highlight/index.js"
    },
    "./grammars/*/highlight": {
      "@hihyou/source": "./src/grammars/*/highlight.ts",
      "types": "./dist/grammars/*/highlight.d.ts",
      "default": "./dist/grammars/*/highlight.js"
    },
    "./grammars/*": {
      "@hihyou/source": "./src/grammars/*/index.ts",
      "types": "./dist/grammars/*/index.d.ts",
      "default": "./dist/grammars/*/index.js"
    },
    "./grammars/*/fmt": {
      "@hihyou/source": "./src/grammars/*/fmt.ts",
      "types": "./dist/grammars/*/fmt.d.ts",
      "default": "./dist/grammars/*/fmt.js"
    }
  },
  "scripts": {
    "postinstall": "node generate.mjs",
    "generate": "node generate.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "emoji-regex": "10.6.0",
    "get-east-asian-width": "1.6.0",
    "narrow-emojis": "0.0.3"
  },
  "devDependencies": {
    "@shikijs/engine-javascript": "2.5.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "prettier": "3.9.9",
    "shiki": "2.5.0",
    "tree-sitter-css": "workspace:*",
    "tree-sitter-html": "workspace:*",
    "tree-sitter-javascript": "workspace:*",
    "tree-sitter-jsdoc": "workspace:*",
    "tree-sitter-json": "workspace:*",
    "tree-sitter-kotlin": "workspace:*",
    "tree-sitter-python": "workspace:*",
    "tree-sitter-regex": "workspace:*",
    "tree-sitter-typescript": "workspace:*",
    "tsdown": "^0.23.0"
  }
}
