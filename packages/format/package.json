{
  "name": "@hihyou/format",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@hihyou/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json": {
      "@hihyou/source": "./src/json/index.ts",
      "types": "./dist/json/index.d.ts",
      "default": "./dist/json/index.js"
    }
  },
  "dependencies": {
    "emoji-regex": "10.6.0",
    "get-east-asian-width": "1.6.0",
    "narrow-emojis": "0.0.3",
    "syntechs": "workspace:*"
  },
  "devDependencies": {
    "@hihyou/engine": "workspace:*",
    "prettier": "3.9.9"
  }
}
