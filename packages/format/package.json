{
  "name": "@hihyou/format",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:grammar": "node src/gen-grammar.node.ts json tree-sitter-json && biome format --write src/json/grammar.ts"
  },
  "exports": {
    ".": {
      "@hihyou/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./json": {
      "@hihyou/source": "./src/json/index.ts",
      "types": "./dist/json/index.d.ts",
      "default": "./dist/json/index.js"
    }
  },
  "dependencies": {
    "get-east-asian-width": "1.7.0"
  },
  "devDependencies": {
    "@hihyou/engine": "workspace:*",
    "prettier": "3.9.9"
  }
}
